{
  "name": "@byted-codebase/tmux-worktree",
  "version": "1.0.25",
  "type": "module",
  "description": "AI + tmux + git worktree workspace manager with a macOS Dashboard, local sessions, automations, and SSH remote TW-managed worktrees",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sskift/tmux-worktree.git"
  },
  "license": "MIT",
  "files": [
    "dist",
    "app/installer/installer.mjs"
  ],
  "bin": {
    "tmux-worktree": "dist/cli.cjs",
    "tw": "dist/cli.cjs",
    "tw-dashboard-install": "app/installer/installer.mjs"
  },
  "scripts": {
    "build": "tsup && tsup --config tsup.standalone.config.ts",
    "validate:package": "node scripts/validate-package.mjs",
    "check:contracts": "node scripts/check-contract-constants.mjs",
    "prepack": "npm run build && npm run validate:package",
    "demo": "npm --prefix app run demo",
    "test:cli": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "test:only": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:interop": "npm run build && node scripts/relay-v2-interop.mjs",
    "test:fault-injection": "node scripts/relay-v2-fault-injection.mjs",
    "test:soak": "node scripts/internal/relayV2Soak.mjs",
    "verify": "sh scripts/verify.sh core",
    "verify:interop": "sh scripts/verify.sh interop",
    "verify:android": "sh scripts/verify.sh android",
    "verify:all": "sh scripts/verify.sh all",
    "verify:device": "sh scripts/verify.sh device"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/ws": "^8.5.0",
    "esbuild": "^0.27.3",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  }
}
